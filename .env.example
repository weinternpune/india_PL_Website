# INDIA P.L. Admin & Operations Portal API Configuration
# When you have your backend server ready, put its URL below:
# Example: http://localhost:8000/api/v1 or https://api.indiapl.com/v1

VITE_API_BASE_URL=

# Set to 'false' when you want only real backend API calls.
# Set to 'true' to allow automatic fallback to persistent local store if backend is not reachable.
VITE_USE_MOCK_FALLBACK=true
